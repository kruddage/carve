{
  "name": "carve",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hard-surface CSG modeler for the web, WebXR + WebGPU",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.12",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "manifold-3d": "^3.5.1",
    "three": "^0.185.1"
  }
}
